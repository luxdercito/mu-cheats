  --printf("%.4x", moduleBase)
  --printf("%.4x", moduleSize)

  --local aobString = "55 8B EC ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? 00 ?? ?? ?? ?? ?? ?? ?? A1 34 ?? ?? ?? 33 ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? FF ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ?? ??"
  --local aobString = "55 8B EC"

  -- Realizar el escaneo AOB
  local results = AOBScan(aobString, "+W+X", 1, 4)

  -- Comprobar si se encontraron resultados
  if results then



      local longitud = results.Count  -- Obtener la cantidad de resultados
      local ultimosTres = {}

      -- Asegurarse de que hay al menos 3 elementos
      for i = 1, 1 do

          if longitud - i + 1 &gt; 0 then  -- Verificar que el índice no esté fuera de límites
              ultimosTres[i] = results[longitud - i]  -- Acceder a los últimos elementos
              print(results[longitud - i])
          end
      end

      -- Iterar sobre los últimos tres elementos
      for i = 1, #ultimosTres do  -- Cambiar a 1 para empezar desde el primer elemento
          local addressHex = ultimosTres[i]  -- Obtener la dirección como cadena
          local address = tonumber(addressHex, 16)  -- Convertir de hexadecimal a número


          -- Verificar si la dirección está fuera del rango
          if address &lt;= moduleBase and address &gt;= moduleBase + moduleSize then i=i+1 end
          print(i .. " Encontrada dirección: " .. addressHex .. " " .. (#ultimosTres - 1))

          oldresult[#oldresult + 1] = address
          writeByte(address, 0XC3)
          --writeByte(address + 0x2b0, 0xC3)
          --writeByte(address + 0x390, 0xC3)
          --writeByte(address+0x2b0, 0xC3)  -- Asegúrate de que writeByte esté definido
      end




      --[[for i = 0, results.Count - 1 do
          local addressHex = results[i]  -- Obtener la dirección como cadena
          local address = tonumber(addressHex, 16)  -- Convertir de hexadecimal a número
          if address &lt;= moduleBase and address &gt;= moduleBase + moduleSize then i=i+1 end
          print(i .. " Encontrada dirección: " .. addressHex .. " " .. (results.Count - 1))
          oldresult[#oldresult + 1] = address
          writeByte(address, 0XC3)

      end]]


      --[[for _, address in ipairs(oldresult) do
          print(address)
      end]]

  else
      print("No se encontraron resultados.")
  end

  if results then
      results.destroy()
  end
end


