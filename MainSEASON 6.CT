mov ecx, 256                 // Cargar 256 en ECX (escala)
mul ecx                      // Multiplicar EAX por 256
mov ecx, 360                 // Cargar 360 en ECX (ángulo total)
div ecx                      // Dividir por 360 (normalizar al rango [0, 255])

// Ajustar el resultado final
and al, 0xFF                 // Mantener solo el byte bajo (0-255)

