local int_push_ebp = findAddressInModule("55 8B EC")






local xor_splash = findAddressInModule("2E 5C 58 6F 72 5F 50 6C 75 73 5C 53 70 6C 61 73 68 5C 58 6F 72 2D 68 61 63 6B 2E 62 6D 70")
local xor_splash_rev = reverseBytes(xor_splash[1])
local xor_splash_b = convertHexToBytes(xor_splash_rev)
local xor_splash_asm_coincidences = findAddressInModule(xor_splash_b)




-- Encontrar las direcciones más cercanas
local xor_splash_closest_push_ebp_list = findClosestAddress(xor_splash_asm_coincidences, int_push_ebp)

-- Iterar sobre los resultados devueltos por findClosestAddress
for _, record in ipairs(xor_splash_closest_push_ebp_list) do
    if record.closestAddr then
        -- Formatear la dirección más cercana en hexadecimal
        local formattedAddress = string.format('%X', record.closestAddr)
        oldresult[#oldresult + 1] = formattedAddress
        writeByte(formattedAddress, 0XC3)
        print(formattedAddress)
    else
        print("No se encontró una dirección más cercana válida. xor_splash")
    end
end







