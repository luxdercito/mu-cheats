          <AssemblerScript>{$lua}
if syntaxcheck then return end

[ENABLE]
oldresult = {}

--reinitializeSymbolhandler("FALSE")

local moduleName = "xor.dll"
local moduleBase = getAddress(moduleName)
local moduleSize = getModuleSize(moduleName)

-- Función para buscar direcciones en el módulo usando AOBScan
local function findAddressInModule(aobPattern)
    local results = AOBScan(aobPattern, "+W+X-C", 1)
    local finalResults = {}

    if results then
        for i = 0, results.Count - 1 do
            local address = tonumber(results[i], 16)
            if address &gt;= moduleBase and address &lt; (moduleBase + moduleSize) then
                table.insert(finalResults, address)
            end
        end
        results.destroy()
    else
        print("No se encontraron resultados para el patrón:", aobPattern)
    end

    return finalResults
end

-- Función para invertir bytes (Big Endian -&gt; Little Endian)
local function reverseBytes(num)
    local hexValue = string.format('%X', num)
    hexValue = #hexValue % 2 ~= 0 and '0' .. hexValue or hexValue
    local reversedHex = ""
    for i = #hexValue, 1, -2 do
        reversedHex = reversedHex .. hexValue:sub(i - 1, i)
    end
    return reversedHex
end

-- Función para convertir hexadecimal a bytes separados por espacios
local function convertHexToBytes(hex)
    assert(#hex % 2 == 0, "El valor hexadecimal debe tener un número par de caracteres.")
    local bytes = {}
    for i = 1, #hex, 2 do
        table.insert(bytes, hex:sub(i, i + 1))
    end
    return table.concat(bytes, " ")
end

-- Función para encontrar la dirección más cercana
local function findClosestAddress(firstTable, secondTable)
    local closestAddresses = {}

    for _, firstAddr in ipairs(firstTable) do
        local closestAddr, smallestDiff = nil, math.huge
        for _, secondAddr in ipairs(secondTable) do
            local diff = math.abs(firstAddr - secondAddr)
            if diff &lt; smallestDiff then
                smallestDiff, closestAddr = diff, secondAddr
            end
        end
        table.insert(closestAddresses, closestAddr)
    end

    return closestAddresses
end

-- Función para escribir bytes en direcciones
local function writeBytesToAddresses(addresses, byteValue)
    for _, addr in ipairs(addresses) do
        addr = addr + 2
        local formattedAddress = string.format('%X', addr)
        oldresult[#oldresult + 1] = formattedAddress
        writeBytes(formattedAddress, byteValue)
    end
end

-- Patrones y procesamiento
local int_push_ebp = findAddressInModule("CC CC 55 8B EC")

local function processPattern(pattern, byteValue)
    local addresses = findAddressInModule(pattern)
    if #addresses &gt; 0 then
        local reversedHex = reverseBytes(addresses[1])
        local bytePattern = convertHexToBytes(reversedHex)
        local asmCoincidences = findAddressInModule(bytePattern)
        local closestAddresses = findClosestAddress(asmCoincidences, int_push_ebp)
        writeBytesToAddresses(closestAddresses, byteValue)
    else
        print("No se encontraron direcciones para el patrón:", pattern)
    end
end

-- Procesar patrones específicos
processPattern("2E 5C 58 6F 72 5F 50 6C 75 73 5C 53 70 6C 61 73 68 5C 58 6F 72 2D 68 61 63 6B 2E 62 6D 70", 0xC3)
--processPattern("55 6E 6B 6E 6F 77 6E", 0xC3)
--[[
--global_ban_bypass = {moduleBase+0x34FD0, moduleBase+0x52A30}
global_ban_bypass = {moduleBase+0x58700, moduleBase+0x58CF0}

writeBytesToAddresses(global_ban_bypass, 0xC3)
]]
