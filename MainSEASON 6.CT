        <CheatEntry>
          <ID>2224</ID>
          <Description>"DIS AH XOR (DISABLE ALL)"</Description>
          <LastState/>
          <Color>64FF00</Color>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>{$lua}
if syntaxcheck then return end
[ENABLE]
oldresult = {}

local moduleName = "xor.dll"
local moduleBase = getAddress(moduleName)
local moduleSize = getModuleSize(moduleName)


function findAddressInModule(aobPattern)
    -- Realizar la búsqueda AOB
    local results = AOBScan(aobPattern, "+W+X-C", 1)--, 4)

    local finalresults = {}  -- Inicializar como tabla vacía
    if results then
        -- Iterar sobre los resultados encontrados
        for i = 0, results.Count - 1 do
            local addressHex = results[i]  -- Obtener la dirección como cadena
            local address = tonumber(addressHex, 16)  -- Convertir de hexadecimal a número

            -- Verificar si la dirección está dentro del rango del módulo
            if address &gt;= moduleBase and address &lt; (moduleBase + moduleSize) then
                --print(i .. " Encontrada dirección: " .. addressHex .. " " .. (results.Count - 1))
                --finalresults[#finalresults + 1] = address
                table.insert(finalresults, address)  -- Agregar la dirección a la tabla
            end
        end

        return finalresults  -- Retornar la tabla de direcciones encontradas
    else
        print("No se encontraron resultados.")
    end

    if results then
        results.destroy()
    end
end



function reverseBytes(num)
    -- Convertir el número entero a una cadena hexadecimal
    local hexValue = string.format('%X', num)

    -- Asegurarse de que la longitud de la cadena hexadecimal sea par
    if #hexValue % 2 ~= 0 then
        hexValue = '0' .. hexValue
    end

    -- Invertir el orden de los bytes
    local reversedHex = ''
    for i = #hexValue, 1, -2 do
        reversedHex = reversedHex .. string.sub(hexValue, i-1, i)
    end
    return reversedHex
end

function convertHexToBytes(hex)
    -- Asegúrate de que el hex tenga un número par de caracteres
    if #hex % 2 ~= 0 then
        error("El valor hexadecimal debe tener un número par de caracteres.")
    end

    local bytes = {}
    -- Iterar sobre la cadena hexadecimal en pasos de 2
    for i = 1, #hex, 2 do
        local byte = hex:sub(i, i + 1)  -- Obtener dos caracteres
        table.insert(bytes, byte)  -- Agregar el byte a la tabla
    end

    -- Concatenar los bytes con un espacio
    return table.concat(bytes, " ")
end


--[[
local num = 0x1234ABCD
print('Big Endian:\t' .. string.format('%X', num))

local converted = reverseBytes(num)
print('Little Endian:\t' .. converted)
]]



function findClosestAddress(firstTable, secondTable)
    local closestAddresses = {}

    for _, firstAddr in ipairs(firstTable) do
        local closestAddr = nil
        local smallestDiff = math.huge  -- Inicializar con un valor grande

        for _, secondAddr in ipairs(secondTable) do
            local diff = math.abs(firstAddr - secondAddr)  -- Calcular la diferencia absoluta

            if diff &lt; smallestDiff then
                smallestDiff = diff
                closestAddr = secondAddr
            end
        end

        -- Guardar el resultado para la dirección actual de la primera tabla
        table.insert(closestAddresses, {firstAddr = firstAddr, closestAddr = closestAddr, diff = smallestDiff})
        --table.insert(closestAddr)
    end

    return closestAddresses
end

function changeaob(results)
  -- Comprobar si se encontraron resultados
  if results then

      for i = 0, results.Count - 1 do
          local addressHex = results[i]  -- Obtener la dirección como cadena
          local address = tonumber(addressHex, 16)  -- Convertir de hexadecimal a número
          if address &lt;= moduleBase and address &gt;= moduleBase + moduleSize then i=i+1 end
          print(i .. " Encontrada dirección: " .. addressHex .. " " .. (results.Count - 1))
          oldresult[#oldresult + 1] = address
          writeByte(address, 0XC3)

      end

  else
      print("No se encontraron resultados.")
  end

  if results then
      results.destroy()
  end
end







local results1 = findAddressInModule("55 6E 6B 6E 6F 77 6E")
local results2 = reverseBytes(results1[1])
local results3 = convertHexToBytes(results2)
local results4 = findAddressInModule(results2)
local results5 = findAddressInModule("55")
local results6 = findClosestAddress(results4, results5)
local results7 = findAddressInModule("CC CC")
local results8 = findClosestAddress(results4, results7)

for _, address in ipairs(results6) do
    -- Asegúrate de que closestAddr esté inicializado
    if address.closestAddr == nil then
        address.closestAddr = 0
    end

    -- Incrementa closestAddr en 1
    address.closestAddr = address.closestAddr-- + 2

    -- Formatea el valor incrementado a hexadecimal
    local formattedAddress = string.format('%X', address.closestAddr)

    -- Agrega el valor formateado a oldresult
    oldresult[#oldresult + 1] = formattedAddress

    -- Convierte el valor formateado a número y escribe en la dirección
    writeByte(formattedAddress, 0XC3)

    -- Imprime el valor formateado
    print(formattedAddress)
end


for _, address in ipairs(results8) do
    -- Asegúrate de que closestAddr esté inicializado
    if address.closestAddr == nil then
        address.closestAddr = 0
    end

    -- Incrementa closestAddr en 1
    address.closestAddr = address.closestAddr + 2

    -- Formatea el valor incrementado a hexadecimal
    local formattedAddress = string.format('%X', address.closestAddr)

    -- Agrega el valor formateado a oldresult
    oldresult[#oldresult + 1] = formattedAddress

    -- Convierte el valor formateado a número y escribe en la dirección
    writeByte(formattedAddress, 0XC3)

    -- Imprime el valor formateado
    print(formattedAddress)
end








