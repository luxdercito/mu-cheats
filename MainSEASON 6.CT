mycode:
cmp [mustend],1
je return
mov eax,["Main.exe"+0A7C224]        // Cargar la dirección base
mov eax,[eax+8]
mov ebx,eax                      // Leer el puntero del primer monstruo

mov edx,[imax]                       // Cargar el valor de imax en edx
cmp [i],edx                          // Comparar i con 30

jna loop                             // Si i &gt;= imax, saltar a loop
mov [i],0                            // Reiniciar i a 1

loop:
    mov edx,0
    imul edx,[i],598              // Multiplicar i por 0x598
    add ebx,edx                      // currmonster = MONSTER_0_ADDRESS + (i * 0x598)
    add [i],1

outloop:
    cmp [ebx+320],#2                 // Comparar tipo de monstruo
    jne delay                       // Si no es tipo 2, saltar a mycode

    cmp [ebx+24],#8                  // Comparar is_dead con 8
    jae delay                       // Si is_dead &lt;= 8, saltar a mycode

    cmp [ebx+24],#102                // Comparar is_dead con 102
    jae delay                       // Si is_dead &gt;= 102, saltar a mycode

    cmp [ebx+CC],#0                  // Comparar estado muerto 2
    jne delay                       // Si no es 0, saltar a mycode

    cmp word ptr [ebx+7E],#0        // Comparar monsterid
    je delay                        // Si monsterid es 0, saltar a mycode

    // Leer las coordenadas del jugador
    mov eax,[400000+77C4F04]         // Cargar la dirección base del jugador
    mov ecx,[eax+AC]                 // Leer myx
    mov edx,[eax+B0]                 // Leer myy

    // Leer las coordenadas del monstruo
    mov esi,[ebx+AC]                 // Leer x del monstruo
    mov edi,[ebx+B0]                 // Leer y del monstruo

    // Calcular abs(x - myx)
    sub esi,ecx                      // x - myx
    jns no_abs_x                     // Si el resultado es positivo, saltar a no_abs_x
    neg esi                          // Hacer abs(x - myx)

no_abs_x:
