// Caso predominante horizontal
mov al,dl                    // dx en AL
mov bl,dh                    // dy en BL
jmp calculate_angle

more_vertical:
mov al,dh                    // dy en AL
mov bl,dl                    // dx en BL

calculate_angle:
// Calcular la relación dy/dx o dx/dy
xor ecx,ecx                  // Limpiar ECX
mov cx,256                   // Cargar 256 en CX (escala)
mul cx                       // Multiplicar AX por 256
div bx                       // Dividir por BX (relación)

// Determinar el cuadrante
test dl,dl                   // Verificar dx
jns check_dy                 // Si dx &gt;= 0, saltar
add al,128                   // Si dx &lt; 0, agregar 180 grados (128 en escala de 256)
check_dy:
test dh,dh                   // Verificar dy
jns normalize_angle          // Si dy &gt;= 0, saltar
neg al                       // Si dy &lt; 0, invertir dirección
add al,256                   // Normalizar a rango 0-255

normalize_angle:
and al,0xFF                  // Mantener solo el byte bajo (0-255)

// Almacenar el ángulo final en CL
