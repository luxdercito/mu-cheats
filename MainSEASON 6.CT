    <CheatEntry>
      <ID>2236</ID>
      <Description>"AUTO KILL TEST NEW"</Description>
      <Options moHideChildren="1" moRecursiveSetValue="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
      <LastState/>
      <Color>64FFFF</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(CustomCode,2048)  // Asigna memoria para el código personalizado
CREATETHREAD(CustomCode)      // Crea un hilo para ejecutar el código

// Etiquetas para variables globales
label(ExitThread)             // Etiqueta para salir del hilo
label(PlayerLoopStart)        // Inicio del bucle de jugadores
label(ProcessPlayerPacket)    // Procesamiento del paquete del jugador
label(WaitBeforeNextAction)   // Espera antes de la próxima acción
label(OriginalPacket)         // Paquete original
label(ModifiedPacket)         // Paquete modificado
label(TargetSkillID)          // Variable para TargetSkillID
label(MaxIterations)          // Variable para MaxIterations
label(ActionDelay)            // Variable para ActionDelay
label(AttackPlayersEnabled)   // Variable para AttackPlayersEnabled
label(ShouldStop)             // Variable para ShouldStop
label(CurrentIndex)           // Variable para CurrentIndex

// Definiciones de variables y símbolos
registersymbol(TargetSkillID)
registersymbol(MaxIterations)
registersymbol(ActionDelay)
registersymbol(AttackPlayersEnabled)
registersymbol(ShouldStop)
registersymbol(CurrentIndex)

// Variables globales
CustomCode:
    mov eax,[ShouldStop]       // Usa EAX para cargar ShouldStop
    cmp eax,1                  // Verifica si debe detenerse
    je ExitThread              // Si ShouldStop == 1, sale del hilo

    mov ebx,["Main.exe"+0A7C224]  // Obtiene la base del jugador
    mov ebx,[ebx+8]            // EBX = dirección del jugador actual

    mov ecx,[MaxIterations]    // Usa ECX para cargar MaxIterations
    cmp [CurrentIndex],ecx     // Compara CurrentIndex con MaxIterations
    jna PlayerLoopStart        // Si CurrentIndex &lt;= MaxIterations, continúa
    mov [CurrentIndex],0       // Reinicia el índice
    push 1
    call sleep                 // Espera 1 ms

PlayerLoopStart:
    mov edx,0
    mov edi,[CurrentIndex]     // Usa EDI para cargar CurrentIndex
    imul edx,edi,598           // Calcula el desplazamiento
    add ebx,edx                // EBX = dirección del jugador + desplazamiento
    inc [CurrentIndex]         // Incrementa el índice

    mov esi,[AttackPlayersEnabled]  // Usa ESI para cargar AttackPlayersEnabled
    cmp esi,1                 // Verifica si debe atacar jugadores
    jne CheckPlayerType       // Si AttackPlayersEnabled != 1, salta a CheckPlayerType

    cmp [ebx+320],1           // Verifica el tipo de jugador
    je ProcessPlayerPacket    // Si tipo == 1, procesa el paquete
    cmp [ebx+320],2
    je ProcessPlayerPacket    // Si tipo == 2, procesa el paquete
    jmp WaitBeforeNextAction  // Si no, espera

CheckPlayerType:
    cmp [ebx+320],2           // Verifica el tipo de jugador
    je ProcessPlayerPacket    // Si tipo == 2, procesa el paquete
    jmp WaitBeforeNextAction  // Si no, espera

ProcessPlayerPacket:
    cmp [ebx+24],8            // Verifica condiciones adicionales
    jle PreparePacket         // Si valor &lt;= 8, prepara el paquete
    cmp [ebx+24],66
    jg PreparePacket          // Si valor &gt; 66, prepara el paquete
    jmp WaitBeforeNextAction  // Si no, espera

PreparePacket:
    cmp [ebx+CC],0            // Verifica más condiciones
    jne WaitBeforeNextAction  // Si no cumple, espera
    cmp word ptr [ebx+7E],#0  // Verifica otro campo
    je WaitBeforeNextAction   // Si no cumple, espera

    // Procesa los valores del jugador
    mov eax,[400000+77C4F04]  // Usa EAX para cargar datos del jugador
    mov ecx,[eax+AC]          // ECX = valor del jugador (campo AC)
    mov edx,[eax+B0]          // EDX = valor del jugador (campo B0)
    mov esi,[ebx+AC]          // ESI = valor del jugador actual (campo AC)
    mov edi,[ebx+B0]          // EDI = valor del jugador actual (campo B0)

    sub esi,ecx               // Calcula diferencia X
    jns NoAbsX                // Si positivo, no necesita abs
    neg esi                   // Aplica abs

NoAbsX:
    mov ebp,esi               // Almacena abs(X)
    sub edi,edx               // Calcula diferencia Y
    jns NoAbsY                // Si positivo, no necesita abs
    neg edi                   // Aplica abs

NoAbsY:
    mov eax,6                 // Usa EAX para definir el umbral
    cmp ebp,eax               // Compara abs(X) con el umbral
    jg WaitBeforeNextAction   // Si abs(X) &gt; umbral, espera
    cmp edi,eax               // Compara abs(Y) con el umbral
    jg WaitBeforeNextAction   // Si abs(Y) &gt; umbral, espera

    // Prepara y envía el paquete
    lea ecx,[ModifiedPacket]  // Carga la dirección del paquete modificado
    call Main.exe+50D0        // Llama a la función del juego
    mov ecx,eax
    call Main.exe+50D0
    mov ecx,eax
    call Main.exe+50D0
    mov ecx,eax
    call Main.exe+50D0

    push 00                   // Argumentos para la siguiente llamada
    push 01
    lea ecx,[ModifiedPacket]
    call Main.exe+4D70        // Envía el paquete

    mov eax,[OriginalPacket]  // Usa EAX para cargar el paquete original
    mov [ModifiedPacket],eax  // Restaura el paquete original

    mov eax,[ActionDelay]     // Usa EAX para cargar ActionDelay
    push eax                  // Espera el tiempo especificado
    call sleep

WaitBeforeNextAction:
    push 0                    // Espera breve
    call sleep
    jmp CustomCode            // Repite el ciclo

ExitThread:
    mov eax,[ShouldStop]      // Usa EAX para cargar ShouldStop
    cmp eax,1                 // Verifica si debe detenerse
    jne CustomCode            // Si no, repite
    ret                       // Finaliza el hilo

// Variables globales
TargetSkillID:
    dd #61                    // ID de habilidad

MaxIterations:
    dd #30                    // Máximo de iteraciones

ActionDelay:
    dd 0                      // Tiempo de espera entre acciones (ms)

AttackPlayersEnabled:
    dd 0                      // Habilita/deshabilita ataque a jugadores

ShouldStop:
    dd 0                      // Bandera para detener el hilo

CurrentIndex:
    dd 0                      // Índice actual

OriginalPacket:
    db 03 00 C1 01 19 00 00 00 00  // Paquete original

ModifiedPacket:
    db 03 00 C1 01 19 00 00 00 00  // Paquete modificado

[DISABLE]
ShouldStop:
    dd 1                      // Detiene el hilo al desactivar el script
</AssemblerScript>
