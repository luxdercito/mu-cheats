    // Calcular abs(y - myy)
    sub edi,edx                      // y - myy
    jns no_abs_y                     // Si el resultado es positivo, saltar a no_abs_y
    neg edi                          // Hacer abs(y - myy)

no_abs_y:
    mov eax,#6                       // Cargar el rango máximo
    cmp ebp,eax                      // Comparar abs(x - myx) con 6
    jg delay                        // Si abs(x - myx) &gt; 6, saltar a mycode

    cmp edi,eax                      // Comparar abs(y - myy) con 6
    jg delay                        // Si abs(y - myy) &gt; 6, saltar a mycode

