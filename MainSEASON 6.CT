    <CheatEntry>
      <ID>2397</ID>
      <Description>"AUTO KILL NEW "WITH C""</Description>
      <Options moHideChildren="1" moRecursiveSetValue="1" moManualExpandCollapse="1" moDeactivateChildrenAsWell="1" moAllowManualCollapseAndExpand="1"/>
      <LastState/>
      <Color>FFFF64</Color>
      <VariableType>Auto Assembler Script</VariableType>
      <AssemblerScript>[ENABLE]
alloc(mycode,2048)
alloc(mustend,50)
alloc(packet,50)
CREATETHREAD(mycode)


label(return)


label(i)
label(autokillimax)
label(loop)
label(autokillskill)
label(autokilldelay)

label(no_abs_x)
label(no_abs_y)
{
label(process_value)
label(check_player_type)
label(process_value2)
label(process_value3)
label(process_value4)
}
label(autokillattackplayers)
label(autokillonlykillpk)
label(autokillusecombo)


registersymbol(autokillskill)
registersymbol(autokillimax)
registersymbol(autokilldelay)
registersymbol(autokillattackplayers)
registersymbol(autokillonlykillpk)
registersymbol(mycode) //debug
registersymbol(autokillusecombo)


mycode:
mov eax,["Main.exe"+0A7C224]
mov eax,[eax+8]
mov ebx,eax


mov edx,[autokillimax]
cmp [i],edx
jna loop
mov [i],0



push 1
call sleep


loop:
mov edx,0
imul edx,[i],598
add ebx,edx
add [i],1
{
cmp byte ptr ["Main.dll"+15594E4],1
je return
}

cmp byte ptr ["Main.dll"+DA448],1
je return




cmp byte ptr [autokillattackplayers], 1
jne check_autokill_disabled

// Si autokillattackplayers está activado, verificar autokillonlykillpk
cmp byte ptr [autokillonlykillpk], 1
jne check_player_type

// Si autokillonlykillpk está activado, verificar el estado PK
cmp byte ptr [ebx+20], 6
je confirm_attack

cmp byte ptr [ebx+320], 2
je confirm_attack // Si es NPC (2), atacar siempre


jmp return

check_player_type:
// Verificar el tipo de jugador en [ebx+320]
cmp byte ptr [ebx+320], 2
je confirm_attack // Si es NPC (2), atacar siempre

cmp byte ptr [ebx+320], 1
je check_player_logic // Si es jugador real (1), continuar con la lógica

jmp return

check_autokill_disabled:
// Lógica alternativa si autokillattackplayers no está activado
cmp byte ptr [ebx+320], 2
je confirm_attack
jmp return

check_player_logic:
// Lógica para jugadores reales
cmp byte ptr [ebx+320], 2
je confirm_attack // Si es NPC (2), atacar siempre

cmp byte ptr [autokillonlykillpk], 1
jne confirm_attack

cmp byte ptr [ebx+20], 6
je confirm_attack

jmp return

confirm_attack:
// Aquí va la lógica para confirmar el ataque
// (Puedes agregar aquí las instrucciones específicas para el ataque)






cmp byte ptr [ebx+24],8
jle process_value
cmp byte ptr [ebx+24],66
jg process_value
jmp return

process_value:             ////////////


cmp dword ptr [ebx+CC],0 //edited
jne return
{
cmp byte ptr [ebx+4],0 //new
jne return
}
cmp byte ptr [ebx+21],0 //new
jne return

cmp byte ptr [ebx+30C],#1 //new
jne return



cmp word ptr [ebx+7E],#0
je return

mov eax,[400000+77C4F04]
mov ecx,[eax+AC] //my x
mov edx,[eax+B0] //my y
mov esi,[ebx+AC] //mob x
mov edi,[ebx+B0] //mob y


cmp eax,ebx //compare if its me
je return

sub esi,ecx
jns no_abs_x
neg esi

no_abs_x:
mov ebp,esi
sub edi,edx
jns no_abs_y
neg edi

no_abs_y:
mov eax,#6
cmp ebp,eax
jge return
cmp edi,eax
jge return

//aditional secure
add ebp,edi
cmp ebp,#12
jge return



mov edx,[ebx+7e]
and edx,000000FF
push edx
mov eax,[ebx+7e]
sar eax,08
push eax

